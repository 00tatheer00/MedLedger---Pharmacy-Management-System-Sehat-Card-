# ============================================
# MedLedger Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================

# --- Supabase ---
# Your Supabase project URL (e.g., https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (safe for client-side use, RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SERVER-SIDE ONLY — bypasses RLS)
# WARNING: Never expose this key to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
# Base URL of the application (e.g., http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment identifier (development | staging | production)
# Used for environment banners and seed script protection.
NEXT_PUBLIC_APP_ENV=development

# --- Auth ---
# Secret used for signing tokens/cookies (generate a strong random string)
# e.g., openssl rand -base64 32
AUTH_SECRET=
